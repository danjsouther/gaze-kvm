<Project Sdk="Microsoft.NET.Sdk">
  <!-- Forwards Tobii.Interaction (Tobii Core SDK) data to gazekvm over localhost UDP.
       Build for x64: the package picks its native DLL by $(Platform). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>gazekvm-tobii</AssemblyName>
    <RootNamespace>GazekvmTobii</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tobii.Interaction" Version="0.7.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
